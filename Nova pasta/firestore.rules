rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasUserDoc() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasAnyRole() {
      return hasUserDoc() && currentRole() in ['Produtor', 'Gestor', 'Operador', 'Integradora', 'Fornecedor', 'Leiloeiro', 'TÃ©cnico', 'Tecnico', 'Investidor', 'Gestor de Trafego', 'Administrador'];
    }

    function claimRole() {
      return signedIn() && request.auth.token.role is string
        ? request.auth.token.role
        : null;
    }

    function claimTenantId() {
      return signedIn() && request.auth.token.tenantId is string
        ? request.auth.token.tenantId
        : null;
    }

    function currentTenantId() {
      return hasUserDoc() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId : null;
    }

    function hasTenantAccess(tenantId) {
      return signedIn() && (
        claimTenantId() == tenantId ||
        // Transitional fallback (1 release) while all users receive custom claims.
        (hasUserDoc() && currentTenantId() == tenantId)
      );
    }

    function isProducerRole() {
      return signedIn() && (
        claimRole() == 'PRODUCER' ||
        (hasUserDoc() && currentRole() == 'Produtor')
      );
    }

    function hasSeedProducerScope() {
      return signedIn()
        && request.auth.token.producerScopes is map
        && request.auth.token.producerScopes.seedProducer == true;
    }

    function canAccessTenantSeeds(tenantId) {
      return hasTenantAccess(tenantId) && (
        (isProducerRole() && hasSeedProducerScope()) ||
        isManagerRole() ||
        isAdminRole()
      );
    }

    function isSupplierRole() {
      return signedIn() && (
        claimRole() == 'SUPPLIER' ||
        (hasUserDoc() && currentRole() == 'Fornecedor')
      );
    }

    function isIntegratorRole() {
      return signedIn() && (
        claimRole() == 'INTEGRATOR' ||
        (hasUserDoc() && currentRole() == 'Integradora')
      );
    }

    function isManagerRole() {
      return signedIn() && (
        claimRole() == 'MANAGER' ||
        (hasUserDoc() && currentRole() == 'Gestor')
      );
    }

    function isAdminRole() {
      return signedIn() && (
        claimRole() == 'ADMIN' ||
        (hasUserDoc() && currentRole() == 'Administrador')
      );
    }

    function isAuctioneerRole() {
      return signedIn() && (
        claimRole() == 'AUCTIONEER' ||
        (hasUserDoc() && currentRole() == 'Leiloeiro')
      );
    }

    function isOperatorRole() {
      return signedIn() && (
        claimRole() == 'OPERATOR' ||
        (hasUserDoc() && currentRole() == 'Operador')
      );
    }

    function isTrafficManagerRole() {
      return signedIn() && (
        claimRole() == 'TRAFFIC_MANAGER' ||
        (hasUserDoc() && currentRole() == 'Gestor de Trafego')
      );
    }

    function isInvestorRole() {
      return signedIn() && (
        claimRole() == 'INVESTOR' ||
        (hasUserDoc() && currentRole() == 'Investidor')
      );
    }

    function hasResourceTenantAccess(data) {
      return signedIn() && (
        (data.tenantId is string && hasTenantAccess(data.tenantId)) ||
        (!(data.tenantId is string) && (
          (data.createdByUserId is string && request.auth.uid == data.createdByUserId) ||
          (data.userId is string && request.auth.uid == data.userId) ||
          (data.requestorUserId is string && request.auth.uid == data.requestorUserId)
        ))
      );
    }

    function hasRequestedTenantAccess(data) {
      return signedIn() && data.tenantId is string && hasTenantAccess(data.tenantId);
    }

    function tenantScopedUpdateAllowed() {
      return (
        resource.data.tenantId is string &&
        request.resource.data.tenantId is string &&
        request.resource.data.tenantId == resource.data.tenantId &&
        hasTenantAccess(resource.data.tenantId)
      ) || (
        !(resource.data.tenantId is string) &&
        hasRequestedTenantAccess(request.resource.data)
      );
    }

    function canManageStockData() {
      return isProducerRole() || isSupplierRole() || isManagerRole() || isAdminRole();
    }

    function canManageFinanceData() {
      return isProducerRole() || isSupplierRole() || isIntegratorRole() || isInvestorRole() || isTrafficManagerRole() || isManagerRole() || isAdminRole();
    }

    function canManageLogisticsData() {
      return isProducerRole() || isSupplierRole() || isIntegratorRole() || isOperatorRole() || isTrafficManagerRole() || isManagerRole() || isAdminRole();
    }

    function canManageContractsData() {
      return isProducerRole() || isIntegratorRole() || isManagerRole() || isAdminRole();
    }

    function canManageSupplierData() {
      return isSupplierRole() || isManagerRole() || isAdminRole();
    }

    function canManageIntegratorData() {
      return isIntegratorRole() || isManagerRole() || isAdminRole();
    }

    function canReadProducerDirectory() {
      return isProducerRole() || isSupplierRole() || isIntegratorRole() || isManagerRole() || isAdminRole();
    }

    function canReadNetworkNeeds() {
      return isProducerRole() || isSupplierRole() || isIntegratorRole() || isOperatorRole() || isAuctioneerRole() || isManagerRole() || isAdminRole();
    }

    function canManageProducerCoreData() {
      return isProducerRole() || isOperatorRole() || isManagerRole() || isAdminRole();
    }

    function canManageCarbonData() {
      return isProducerRole() || isManagerRole() || isAdminRole();
    }

    function canManageInvestorData() {
      return isInvestorRole() || isManagerRole() || isAdminRole();
    }

    function canManageFutureMarketData() {
      return isProducerRole() || isInvestorRole() || isManagerRole() || isAdminRole();
    }

    function canUseOperatorPortal() {
      return isOperatorRole() || isProducerRole() || isManagerRole() || isAdminRole();
    }

    function canDecideOperatorRequest() {
      return isProducerRole() || isManagerRole() || isAdminRole();
    }

    function canManageOperatorAccess() {
      return signedIn() && (
        isProducerRole() ||
        isManagerRole() ||
        isAdminRole()
      );
    }

    function canManageAuctionOps() {
      return signedIn() && (
        isAuctioneerRole() ||
        isManagerRole() ||
        isAdminRole()
      );
    }

    function canCaptureAuctionSignals() {
      return signedIn() && (
        canManageAuctionOps() ||
        claimRole() == 'OPERATOR' ||
        (hasUserDoc() && currentRole() == 'Operador')
      );
    }

    function listingCategoryValid(data) {
      return data.listingCategory is string
        && data.listingCategory in ['OUTPUTS_PRODUCER', 'INPUTS_INDUSTRY', 'AUCTION_P2P'];
    }

    function listingModeValidForCategory(data) {
      return !(data.listingCategory == 'AUCTION_P2P')
        || (data.listingMode is string && data.listingMode == 'AUCTION');
    }

    function listingStatusValid(data) {
      return !(data.status is string) || data.status in ['DRAFT', 'PUBLISHED', 'PAUSED', 'CLOSED'];
    }

    function listingStatusTransitionAllowed() {
      return request.resource.data.status == resource.data.status
        || request.resource.data.status in ['PUBLISHED', 'PAUSED', 'CLOSED'];
    }

    function listingCategoryImmutable() {
      return request.resource.data.listingCategory == resource.data.listingCategory;
    }

    function canWriteListingCategory(data) {
      return isAdminRole()
        || isManagerRole()
        || (isProducerRole() && data.listingCategory in ['OUTPUTS_PRODUCER', 'AUCTION_P2P'])
        || (isSupplierRole() && data.listingCategory == 'INPUTS_INDUSTRY');
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || hasAnyRole();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || hasAnyRole();
      allow delete: if false;
    }

    match /properties/{docId} {
      allow read: if signedIn() && hasResourceTenantAccess(resource.data);
      allow create: if isProducerRole() && hasRequestedTenantAccess(request.resource.data);
      allow update: if isProducerRole() && tenantScopedUpdateAllowed();
      allow delete: if (isManagerRole() || isAdminRole()) && hasResourceTenantAccess(resource.data);
    }

    match /pastures/{docId} {
      allow read: if signedIn() && hasResourceTenantAccess(resource.data);
      allow create: if isProducerRole() && hasRequestedTenantAccess(request.resource.data);
      allow update: if isProducerRole() && tenantScopedUpdateAllowed();
      allow delete: if (isManagerRole() || isAdminRole()) && hasResourceTenantAccess(resource.data);
    }

    match /productionProjects/{docId} {
      allow read: if signedIn() && hasResourceTenantAccess(resource.data);
      allow create: if isProducerRole() && hasRequestedTenantAccess(request.resource.data);
      allow update: if isProducerRole() && tenantScopedUpdateAllowed();
      allow delete: if (isManagerRole() || isAdminRole()) && hasResourceTenantAccess(resource.data);
    }

    match /inventoryItems/{docId} {
      allow read: if canManageStockData() && hasResourceTenantAccess(resource.data);
      allow create: if canManageStockData() && hasRequestedTenantAccess(request.resource.data);
      allow update: if canManageStockData() && tenantScopedUpdateAllowed();
      allow delete: if false;
    }

    match /stockMovements/{docId} {
      allow read: if canManageStockData() && hasResourceTenantAccess(resource.data);
      allow create: if canManageStockData() && hasRequestedTenantAccess(request.resource.data);
      allow update: if canManageStockData() && tenantScopedUpdateAllowed();
      allow delete: if false;
    }

    match /auditEvents/{docId} {
      allow read: if hasAnyRole() && hasResourceTenantAccess(resource.data);
      allow create: if hasAnyRole() && hasRequestedTenantAccess(request.resource.data);
      allow update: if isAdminRole() && tenantScopedUpdateAllowed();
      allow delete: if false;
    }

    match /bankAccounts/{docId} {
      allow read: if canManageFinanceData() && hasResourceTenantAccess(resource.data);
      allow create: if canManageFinanceData() && hasRequestedTenantAccess(request.resource.data);
      allow update: if canManageFinanceData() && tenantScopedUpdateAllowed();
      allow delete: if (isManagerRole() || isAdminRole()) && hasResourceTenantAccess(resource.data);
    }

    match /receivables/{docId} {
      allow read: if canManageFinanceData() && hasResourceTenantAccess(resource.data);
      allow create: if canManageFinanceData() && hasRequestedTenantAccess(request.resource.data);
      allow update: if canManageFinanceData() && tenantScopedUpdateAllowed();
      allow delete: if (isManagerRole() || isAdminRole()) && hasResourceTenantAccess(resource.data);
    }

    match /expenses/{docId} {
      allow read: if canManageFinanceData() && hasResourceTenantAccess(resource.data);
      allow create: if canManageFinanceData() && hasRequestedTenantAccess(request.resource.data);
      allow update: if canManageFinanceData() && tenantScopedUpdateAllowed();
      allow delete: if (isManagerRole() || isAdminRole()) && hasResourceTenantAccess(resource.data);
    }

    match /transactions/{docId} {
      allow read: if canManageFinanceData() && hasResourceTenantAccess(resource.data);
      allow create: if canManageFinanceData() && hasRequestedTenantAccess(request.resource.data);
      allow update: if canManageFinanceData() && tenantScopedUpdateAllowed();
      allow delete: if (isManagerRole() || isAdminRole()) && hasResourceTenantAccess(resource.data);
    }

    match /marketplaceListings/{docId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && listingCategoryValid(request.resource.data)
        && listingModeValidForCategory(request.resource.data)
        && listingStatusValid(request.resource.data)
        && canWriteListingCategory(request.resource.data);
      allow update: if signedIn()
        && listingCategoryValid(request.resource.data)
        && listingModeValidForCategory(request.resource.data)
        && listingStatusValid(request.resource.data)
        && listingCategoryImmutable()
        && listingStatusTransitionAllowed()
        && canWriteListingCategory(resource.data)
        && (isAdminRole() || isManagerRole() || request.auth.uid == resource.data.createdByUserId);
      allow delete: if false;
    }

    match /corporateCards/{docId} {
      allow read: if hasAnyRole() && hasResourceTenantAccess(resource.data);
      allow create: if hasAnyRole() && hasRequestedTenantAccess(request.resource.data);
      allow update: if hasAnyRole() && tenantScopedUpdateAllowed();
      allow delete: if isAdminRole() && hasResourceTenantAccess(resource.data);
    }

    match /partnerStores/{docId} {
      allow read: if hasAnyRole() && (
        hasResourceTenantAccess(resource.data) ||
        (resource.data.visibility is string && resource.data.visibility in ['PUBLIC', 'OPEN_MARKET'])
      );
      allow create: if hasAnyRole() && hasRequestedTenantAccess(request.resource.data);
      allow update: if hasAnyRole() && tenantScopedUpdateAllowed();
      allow delete: if isAdminRole() && hasResourceTenantAccess(resource.data);
    }

    match /logisticsEntries/{docId} {
      allow read: if (
        canManageLogisticsData() && hasResourceTenantAccess(resource.data)
      ) || (
        signedIn() &&
        resource.data.carrierUserId is string &&
        resource.data.carrierUserId == request.auth.uid
      ) || (
        signedIn() &&
        resource.data.openForMarketplace == true &&
        resource.data.status == 'SOLICITADO'
      );
      allow create: if canManageLogisticsData() && hasRequestedTenantAccess(request.resource.data);
      allow update: if canManageLogisticsData() && tenantScopedUpdateAllowed();
      allow delete: if isAdminRole() && hasResourceTenantAccess(resource.data);
    }

    match /contracts/{docId} {
      allow read: if canManageContractsData() && hasResourceTenantAccess(resource.data);
      allow create: if canManageContractsData() && hasRequestedTenantAccess(request.resource.data);
      allow update: if canManageContractsData() && tenantScopedUpdateAllowed();
      allow delete: if isAdminRole() && hasResourceTenantAccess(resource.data);
    }

    match /salesOffers/{docId} {
      allow read: if hasAnyRole() && hasResourceTenantAccess(resource.data);
      allow create: if hasAnyRole() && hasRequestedTenantAccess(request.resource.data);
      allow update: if hasAnyRole() && tenantScopedUpdateAllowed();
      allow delete: if isAdminRole() && hasResourceTenantAccess(resource.data);
    }

    match /employees/{docId} {
      allow read: if canManageProducerCoreData() && hasResourceTenantAccess(resource.data);
      allow create: if canManageProducerCoreData() && hasRequestedTenantAccess(request.resource.data);
      allow update: if canManageProducerCoreData() && tenantScopedUpdateAllowed();
      allow delete: if (isManagerRole() || isAdminRole()) && hasResourceTenantAccess(resource.data);
    }

    match /timeRecords/{docId} {
      allow read: if canManageProducerCoreData() && hasResourceTenantAccess(resource.data);
      allow create: if canManageProducerCoreData() && hasRequestedTenantAccess(request.resource.data);
      allow update: if canManageProducerCoreData() && tenantScopedUpdateAllowed();
      allow delete: if (isManagerRole() || isAdminRole()) && hasResourceTenantAccess(resource.data);
    }

    match /payrollEntries/{docId} {
      allow read: if canManageProducerCoreData() && hasResourceTenantAccess(resource.data);
      allow create: if canManageProducerCoreData() && hasRequestedTenantAccess(request.resource.data);
      allow update: if canManageProducerCoreData() && tenantScopedUpdateAllowed();
      allow delete: if (isManagerRole() || isAdminRole()) && hasResourceTenantAccess(resource.data);
    }

    match /ppeOrders/{docId} {
      allow read: if canManageProducerCoreData() && hasResourceTenantAccess(resource.data);
      allow create: if canManageProducerCoreData() && hasRequestedTenantAccess(request.resource.data);
      allow update: if canManageProducerCoreData() && tenantScopedUpdateAllowed();
      allow delete: if (isManagerRole() || isAdminRole()) && hasResourceTenantAccess(resource.data);
    }

    match /marketTrends/{docId} {
      allow read: if true;
      allow write: if isAdminRole();
    }

    match /reportConsumptions/{docId} {
      allow read: if canManageProducerCoreData() && hasResourceTenantAccess(resource.data);
      allow create: if canManageProducerCoreData() && hasRequestedTenantAccess(request.resource.data);
      allow update: if canManageProducerCoreData() && tenantScopedUpdateAllowed();
      allow delete: if (isManagerRole() || isAdminRole()) && hasResourceTenantAccess(resource.data);
    }

    match /reportCapacity/{docId} {
      allow read: if canManageProducerCoreData() && hasResourceTenantAccess(resource.data);
      allow create: if canManageProducerCoreData() && hasRequestedTenantAccess(request.resource.data);
      allow update: if canManageProducerCoreData() && tenantScopedUpdateAllowed();
      allow delete: if (isManagerRole() || isAdminRole()) && hasResourceTenantAccess(resource.data);
    }

    match /reportLotAudits/{docId} {
      allow read: if canManageProducerCoreData() && hasResourceTenantAccess(resource.data);
      allow create: if canManageProducerCoreData() && hasRequestedTenantAccess(request.resource.data);
      allow update: if canManageProducerCoreData() && tenantScopedUpdateAllowed();
      allow delete: if (isManagerRole() || isAdminRole()) && hasResourceTenantAccess(resource.data);
    }

    match /sustainablePractices/{docId} {
      allow read: if canManageCarbonData() && hasResourceTenantAccess(resource.data);
      allow create: if canManageCarbonData() && hasRequestedTenantAccess(request.resource.data);
      allow update: if canManageCarbonData() && tenantScopedUpdateAllowed();
      allow delete: if (isManagerRole() || isAdminRole()) && hasResourceTenantAccess(resource.data);
    }

    match /carbonProjects/{docId} {
      allow read: if canManageCarbonData() && hasResourceTenantAccess(resource.data);
      allow create: if canManageCarbonData() && hasRequestedTenantAccess(request.resource.data);
      allow update: if canManageCarbonData() && tenantScopedUpdateAllowed();
      allow delete: if (isManagerRole() || isAdminRole()) && hasResourceTenantAccess(resource.data);
    }

    match /carbonCredits/{docId} {
      allow read: if canManageCarbonData() && hasResourceTenantAccess(resource.data);
      allow create: if canManageCarbonData() && hasRequestedTenantAccess(request.resource.data);
      allow update: if canManageCarbonData() && tenantScopedUpdateAllowed();
      allow delete: if (isManagerRole() || isAdminRole()) && hasResourceTenantAccess(resource.data);
    }

    match /regionalStats/{docId} {
      allow read: if true;
      allow write: if isAdminRole();
    }

    match /newsItems/{docId} {
      allow read: if true;
      allow write: if isAdminRole();
    }

    match /auctionListings/{docId} {
      allow read: if true;
      allow write: if isAdminRole();
    }

    match /auctioneerProfiles/{docId} {
      allow read: if signedIn() && (
        (resource.data.tenantId is string && hasTenantAccess(resource.data.tenantId) && canManageAuctionOps()) ||
        request.auth.uid == docId
      );
      allow create: if canManageAuctionOps() &&
        request.resource.data.tenantId is string &&
        hasTenantAccess(request.resource.data.tenantId) &&
        (request.auth.uid == docId || isManagerRole() || isAdminRole());
      allow update: if canManageAuctionOps() &&
        request.resource.data.tenantId is string &&
        hasTenantAccess(request.resource.data.tenantId) &&
        (request.auth.uid == docId || isManagerRole() || isAdminRole());
      allow delete: if isAdminRole();
    }

    match /auctionLots/{docId} {
      allow read: if signedIn() &&
        resource.data.tenantId is string &&
        hasTenantAccess(resource.data.tenantId);
      allow create: if canManageAuctionOps() &&
        request.resource.data.tenantId is string &&
        hasTenantAccess(request.resource.data.tenantId);
      allow update: if canManageAuctionOps() &&
        resource.data.tenantId is string &&
        hasTenantAccess(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if false;
    }

    match /auctionEvents/{docId} {
      allow read: if signedIn() &&
        resource.data.tenantId is string &&
        hasTenantAccess(resource.data.tenantId);
      allow create: if canManageAuctionOps() &&
        request.resource.data.tenantId is string &&
        hasTenantAccess(request.resource.data.tenantId);
      allow update: if canManageAuctionOps() &&
        resource.data.tenantId is string &&
        hasTenantAccess(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if false;
    }

    match /auctionBidSignals/{docId} {
      allow read: if signedIn() &&
        resource.data.tenantId is string &&
        hasTenantAccess(resource.data.tenantId);
      allow create: if canCaptureAuctionSignals() &&
        request.resource.data.tenantId is string &&
        hasTenantAccess(request.resource.data.tenantId);
      allow update: if canManageAuctionOps() &&
        resource.data.tenantId is string &&
        request.resource.data.tenantId is string &&
        request.resource.data.tenantId == resource.data.tenantId &&
        hasTenantAccess(resource.data.tenantId);
      allow delete: if false;
    }

    match /externalMarketplaceBridges/{docId} {
      allow read: if signedIn() &&
        resource.data.tenantId is string &&
        hasTenantAccess(resource.data.tenantId);
      allow create: if (
          isIntegratorRole() ||
          isSupplierRole() ||
          isManagerRole() ||
          isAdminRole()
        ) &&
        request.resource.data.tenantId is string &&
        hasTenantAccess(request.resource.data.tenantId);
      allow update: if (
          isIntegratorRole() ||
          isSupplierRole() ||
          isManagerRole() ||
          isAdminRole()
        ) &&
        resource.data.tenantId is string &&
        request.resource.data.tenantId is string &&
        request.resource.data.tenantId == resource.data.tenantId &&
        hasTenantAccess(resource.data.tenantId);
      allow delete: if isAdminRole() &&
        resource.data.tenantId is string &&
        hasTenantAccess(resource.data.tenantId);
    }

    match /externalMarketplaceItems/{docId} {
      allow read: if signedIn() &&
        resource.data.tenantId is string &&
        hasTenantAccess(resource.data.tenantId);
      allow create: if (
          isIntegratorRole() ||
          isSupplierRole() ||
          isManagerRole() ||
          isAdminRole()
        ) &&
        request.resource.data.tenantId is string &&
        hasTenantAccess(request.resource.data.tenantId);
      allow update: if (
          isIntegratorRole() ||
          isSupplierRole() ||
          isManagerRole() ||
          isAdminRole()
        ) &&
        resource.data.tenantId is string &&
        request.resource.data.tenantId is string &&
        request.resource.data.tenantId == resource.data.tenantId &&
        hasTenantAccess(resource.data.tenantId);
      allow delete: if (
          isIntegratorRole() ||
          isSupplierRole() ||
          isManagerRole() ||
          isAdminRole()
        ) &&
        resource.data.tenantId is string &&
        hasTenantAccess(resource.data.tenantId);
    }

    match /marketSaturation/{docId} {
      allow read: if true;
      allow write: if isAdminRole();
    }

    match /publicMarketPrices/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /publicMarketPrices/{docId}/points/{pointId} {
      allow read: if true;
      allow write: if false;
    }

    match /publicMarketIndices/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /publicMarketConfig/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /operatorRequests/{docId} {
      allow read: if canUseOperatorPortal() && hasResourceTenantAccess(resource.data);
      allow create: if canUseOperatorPortal() &&
        hasRequestedTenantAccess(request.resource.data) &&
        (
          !isOperatorRole() ||
          (
            request.resource.data.requesterUserId is string &&
            request.resource.data.requesterUserId == request.auth.uid
          )
        );
      allow update: if tenantScopedUpdateAllowed() &&
        (
          canDecideOperatorRequest() ||
          (
            isOperatorRole() &&
            resource.data.requesterUserId is string &&
            resource.data.requesterUserId == request.auth.uid &&
            request.resource.data.status == resource.data.status
          )
        );
      allow delete: if isAdminRole() && hasResourceTenantAccess(resource.data);
    }

    match /operatorAccessAuthorizations/{docId} {
      allow read: if signedIn() && (
        (
          canManageOperatorAccess() &&
          resource.data.tenantId is string &&
          hasTenantAccess(resource.data.tenantId)
        ) ||
        (
          resource.data.operatorAuthEmail is string &&
          request.auth.token.email is string &&
          resource.data.operatorAuthEmail == request.auth.token.email
        )
      );
      allow create: if canManageOperatorAccess() &&
        request.resource.data.tenantId is string &&
        hasTenantAccess(request.resource.data.tenantId);
      allow update: if (
        canManageOperatorAccess() &&
        resource.data.tenantId is string &&
        request.resource.data.tenantId is string &&
        request.resource.data.tenantId == resource.data.tenantId &&
        hasTenantAccess(resource.data.tenantId)
      ) || (
        signedIn() &&
        request.auth.uid is string &&
        request.auth.token.email is string &&
        resource.data.status == 'ATIVO' &&
