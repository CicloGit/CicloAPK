# Firebase real (producao/staging)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=ciclo-plus-f9c8f
FIREBASE_PROJECT_ID=ciclo-plus-f9c8f
VITE_FIREBASE_STORAGE_BUCKET=ciclo-plus-f9c8f.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_BACKEND_BASE_URL=https://us-central1-ciclo-plus-f9c8f.cloudfunctions.net/api
VITE_USE_FIREBASE_EMULATORS=false
SETTLEMENT_PROVIDER=FIRESTORE_LEDGER

# Senha de autorizacao manual
VITE_MANUAL_DELETE_PASSWORD=CICLO123

# Dev local com Firebase Emulator Suite (usar apenas em desenvolvimento)
# Para dev local, copie este bloco para .env.local e ajuste:
# VITE_USE_FIREBASE_EMULATORS=true
# VITE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# VITE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Modulos modulares para operacao em producao
# Estrutura:
# - ERP_CORE: Nucleo/contrato principal do PROJETO_CICLO
# - MPV_CICLO: orquestracao ERP + PDV (sistema externo)
# - CEREBRO_NEXUS: camada de governanca cognitiva e sinais

# ERP Core (opcional em ambiente de modulo interno, obrigatorio se SUPPORT_MODULE_ERP_CORE_ENABLED=true)
SUPPORT_MODULE_ERP_CORE_BASE_URL=
SUPPORT_MODULE_ERP_CORE_ENVIRONMENT=
SUPPORT_MODULE_ERP_CORE_AUTH_MODE=NONE
SUPPORT_MODULE_ERP_CORE_CREDENTIAL_REF=
SUPPORT_MODULE_ERP_CORE_ENABLED=
SUPPORT_MODULE_ERP_CORE_HEALTH_PATH=/health
SUPPORT_MODULE_ERP_CORE_CAPABILITIES=tenant-runtime,audit-chain,market-kernel,support-api
SUPPORT_MODULE_ERP_CORE_MANIFEST_PATH=/v1/support/manifest

# MPV Ciclo (ERP+PDV gateway)
SUPPORT_MODULE_MPV_CICLO_BASE_URL=https://mpv-ciclo.seudominio.com
SUPPORT_MODULE_MPV_CICLO_ENVIRONMENT=PRODUCAO
SUPPORT_MODULE_MPV_CICLO_AUTH_MODE=NONE
SUPPORT_MODULE_MPV_CICLO_CREDENTIAL_REF=
SUPPORT_MODULE_MPV_CICLO_ENABLED=true
SUPPORT_MODULE_MPV_CICLO_HEALTH_PATH=/healthz
SUPPORT_MODULE_MPV_CICLO_CAPABILITIES=smartpos-webhook,pricing-lock,erp-forwarding,scheduler-retry
SUPPORT_MODULE_MPV_CICLO_MANIFEST_PATH=/manifest
MPV_CICLO_SMARTPOS_WEBHOOK_SECRET=
MPV_CICLO_ASAAS_WEBHOOK_SECRET=
MPV_CICLO_ERP_FORWARD_SECRET=

# Cerebro Nexus (motor de integracao e observabilidade)
SUPPORT_MODULE_CEREBRO_NEXUS_BASE_URL=
SUPPORT_MODULE_CEREBRO_NEXUS_ENVIRONMENT=
SUPPORT_MODULE_CEREBRO_NEXUS_AUTH_MODE=NONE
SUPPORT_MODULE_CEREBRO_NEXUS_CREDENTIAL_REF=
SUPPORT_MODULE_CEREBRO_NEXUS_ENABLED=false
SUPPORT_MODULE_CEREBRO_NEXUS_HEALTH_PATH=/health
SUPPORT_MODULE_CEREBRO_NEXUS_CAPABILITIES=governance-engine,evidence-validation,audit-export,signal-fusion
SUPPORT_MODULE_CEREBRO_NEXUS_MANIFEST_PATH=/manifest

# URL do gateway do Nexus para fallback de manifest/health dos modulos externos (opcional para ambiente com proxy dedicado).
SUPPORT_MODULE_NEXUS_GATEWAY_URL=
