{
  "name": "ciclo-plus-erp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc -p tsconfig.json && node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "typecheck": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "verify:portal-channelization": "node ../scripts/verify-portal-channelization.mjs",
    "verify:production-env": "node ../scripts/verify-production-env.mjs",
    "go-live:preflight": "node ../scripts/go-live-preflight.mjs",
    "go-live:smoke": "node ../scripts/go-live-smoke.mjs",
    "uat:multiportal": "node ../scripts/uat-multiportal-smoke.mjs",
    "uat:auth-manager": "node ../scripts/uat-authenticated-manager.mjs",
    "go-live:monitor:snapshot": "node ../scripts/go-live-monitoring-snapshot.mjs",
    "go-live:status": "node ../scripts/go-live-48h-status.mjs",
    "go-live:report": "node ../scripts/go-live-generate-stability-report.mjs",
    "go-live:watch-48h": "powershell -ExecutionPolicy Bypass -File ../scripts/go-live-48h-watch.ps1",
    "go-live:watch-48h:once": "powershell -ExecutionPolicy Bypass -File ../scripts/go-live-48h-watch.ps1 -Once",
    "emulators:start": "npx firebase-tools emulators:start --import=.firebase/emulator-data --export-on-exit=.firebase/emulator-data",
    "emulators:clean": "npx firebase-tools emulators:start --only auth,firestore,storage,functions",
    "firebase:deploy:rules": "npx firebase-tools deploy --only firestore:rules,firestore:indexes,storage",
    "firebase:deploy:functions": "npx firebase-tools deploy --only functions",
    "firebase:deploy:hosting:safe": "bash ../scripts/firebase-deploy-safe.sh"
  },
  "dependencies": {
    "@turf/turf": "^7.3.4",
    "@types/leaflet": "^1.9.21",
    "firebase": "^10.7.0",
    "leaflet": "^1.9.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "firebase-tools": "^15.8.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "terser": "^5.39.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
